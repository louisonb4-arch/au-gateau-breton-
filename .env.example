# Domaine définitif du restaurant (ex. https://www.augateaubreton.fr).
# Tant qu'il n'est pas défini, le site n'est pas indexé par Google : pratique pour une préproduction Vercel.
# NEXT_PUBLIC_SITE_URL=https://www.augateaubreton.fr

# Passe à "true" une fois le backend de réservation branché (voir src/lib/reservation.ts)
NEXT_PUBLIC_RESERVATION_ENABLED=false
